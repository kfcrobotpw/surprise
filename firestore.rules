rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['id', 'name', 'age', 'prizeId', 'prizeName', 'prizeGrade', 'redeemed', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'age', 'favoriteExperience', 'prizeId', 'prizeName', 'prizeGrade', 'prizeEmoji', 'redeemed', 'redeemedAt', 'redeemedBy', 'createdAt', 'deviceId'])
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 50
        && data.age is string && data.age.size() > 0 && data.age.size() <= 30
        && (!('favoriteExperience' in data) || (data.favoriteExperience is string && data.favoriteExperience.size() <= 100))
        && data.prizeId is string && data.prizeId.size() <= 32
        && data.prizeName is string && data.prizeName.size() <= 50
        && data.prizeGrade is string && data.prizeGrade.size() <= 20
        && (!('prizeEmoji' in data) || (data.prizeEmoji is string && data.prizeEmoji.size() <= 10))
        && data.redeemed is bool && data.redeemed == false
        && data.createdAt is string && data.createdAt.size() <= 40
        && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 64));
    }

    function isValidRedemption(incoming, existing) {
      return incoming.id == existing.id
        && incoming.name == existing.name
        && incoming.age == existing.age
        && incoming.prizeId == existing.prizeId
        && incoming.prizeName == existing.prizeName
        && incoming.prizeGrade == existing.prizeGrade
        && incoming.createdAt == existing.createdAt
        && existing.redeemed == false
        && incoming.redeemed == true
        && incoming.diff(existing).affectedKeys().hasOnly(['redeemed', 'redeemedAt', 'redeemedBy']);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow get: if isValidId(ticketId);
      allow list: if true;
      allow create: if isValidId(ticketId) && isValidTicket(request.resource.data) && request.resource.data.id == ticketId;
      allow update: if isValidId(ticketId) && isValidRedemption(request.resource.data, resource.data);
      allow delete: if isValidId(ticketId);
    }

    // Settings / Booth config
    match /settings/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
